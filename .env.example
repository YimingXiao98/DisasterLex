# Required: OpenRouter API key for pipeline LLM calls.
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Required: claim-extraction model (cross-model, defaults to Gemini 2.5 Flash).
EXTRACTOR_MODEL=google/gemini-2.5-flash

# Required if using Qwen 3.6 Flash directly via DashScope.
# DASHSCOPE_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: override the default pipeline LLM (also settable via --pipeline-model).
# LLM_MODEL=google/gemini-3.1-flash-lite-preview

# Optional: explicit path to the DuckDB backend. Defaults to data/disaster_ai_db.duckdb
# under the project root (created by scripts/download_data.sh).
# DISASTER_DB_PATH=/absolute/path/to/disaster_ai_db.duckdb

# Optional: Neo4j connection (defaults match the docker compose example in README).
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# Optional: Tavily search API key (used by the Stage 3 planning ReAct agent for
# current-events queries). Set if you want web-retrieval to be functional;
# benchmarking does not require it.
# TAVILY_API_KEY=tvly-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
